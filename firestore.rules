rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /problems/{problemId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 60
        && request.resource.data.slug is string;
      allow update, delete: if false;
    }

    match /remedies/{remedyId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.votesUp == 0
        && request.resource.data.votesDown == 0
        && request.resource.data.totalVotes == 0;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['votesUp', 'votesDown', 'totalVotes', 'successRate']);
      allow delete: if false;
    }

    match /votes/{voteId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && voteId == request.resource.data.remedyId + '_' + request.auth.uid;
      allow delete: if false;
    }

    match /saves/{saveId} {
      // "read" dekker appens sanntids-spørring "hvilke råd har JEG lagret"
      // (where userId == uid) — en LIST-spørring, ikke bare enkelt-
      // oppslag. Firestore krever at regelen for en LIST kan verifiseres
      // opp mot selve spørre-filteret: regelen må sjekke SAMME felt
      // (userId) som spørringen filtrerer på. Den forrige versjonen sjekket
      // i stedet dokument-IDens mønster, som fungerer fint for et enkelt
      // get()/delete() (se under), men Firestore kan ikke garantere at et
      // ID-mønster gjelder for alle mulige treff i en feltbasert
      // list()-spørring, og avviste derfor HELE listen som
      // "insufficient permissions" — selv om brukeren eide alt i den.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && saveId == request.resource.data.remedyId + '_' + request.auth.uid;
      // delete er ikke en list — det peker på ett bestemt dokument via hele
      // stien, så ID-mønsteret er trygt og presist å sjekke her.
      allow delete: if request.auth != null && saveId.matches('.*_' + request.auth.uid);
      allow update: if false;
    }
  }
}
