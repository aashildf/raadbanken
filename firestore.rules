rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /problems/{problemId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 60
        && request.resource.data.slug is string;
      allow update, delete: if false;
    }

    match /remedies/{remedyId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.votesUp == 0
        && request.resource.data.votesDown == 0
        && request.resource.data.totalVotes == 0;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['votesUp', 'votesDown', 'totalVotes', 'successRate']);
      allow delete: if false;
    }

    match /votes/{voteId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && voteId == request.resource.data.remedyId + '_' + request.auth.uid;
      allow delete: if false;
    }
  }
}
